{
  "name": "glass-mosaic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Glass Mosaic: an almost infinite, mixed-media liquid-glass mosaic searched with real in-browser capabilities. Meta Ray-Ban Display Web App edition.",
  "license": "MIT",
  "author": "Pavel Nasovich (https://github.com/forcewake)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "index:build": "tsx scripts/build-index.ts",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:import-legacy": "tsx scripts/import-legacy-catalog.ts",
    "predev": "npm run index:build",
    "dev": "vite",
    "prebuild": "npm run index:build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
